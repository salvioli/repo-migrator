# Bitbucket: Atlassian account e-mail and an API token with the scopes
# read:repository:bitbucket and read:pullrequest:bitbucket
BB_EMAIL=you@example.com
BB_WORKSPACE=your-bitbucket-workspace
# Read the token from a command instead of storing it here. The command runs
# without a shell, so pipes and $(...) are not supported.
BB_API_TOKEN_CMD=pass show bitbucket/api-token

# GitHub: organization (or your own user name) and a personal access token
GH_ORG=your-github-org
GITHUB_TOKEN_CMD=security find-generic-password -a github-migration -w
# Or from a gpg encrypted file
# GITHUB_TOKEN_CMD=gpg --quiet --decrypt /path/to/github_token.gpg
